#!/bin/sh
# WARNING: REQUIRES /bin/sh
#
# - must run on /bin/sh on solaris 9
# - must run on /bin/sh on AIX 6.x
# - if you think you are a bash wizard, you probably do not understand
#   this programming language.  do not touch.
# - if you are under 40, get peer review from your elders.

INSTALLER_DIR=/opt/cinc
WORKSTATION_DIR=/opt/cinc-workstation

is_darwin() {
  uname -a | grep "^Darwin" 2>&1 >/dev/null
}

if is_darwin; then
    PREFIX="/usr/local"
else
    PREFIX="/usr"
fi

# Remove only links that point into this package, and hand each name back to a
# co-installed Cinc Workstation, which ships all of them.
cleanup_symlinks() {
  for link in cinc-client cinc-solo cinc-apply cinc-shell knife ohai chef-apply chef-client chef-shell chef-solo inspec; do
    if [ -L $PREFIX/bin/$link ]; then
      case "`readlink $PREFIX/bin/$link`" in
        $INSTALLER_DIR/*)
          rm -f $PREFIX/bin/$link
          if [ -x $WORKSTATION_DIR/bin/$link ]; then
            ln -s $WORKSTATION_DIR/bin/$link $PREFIX/bin/$link
          fi
          ;;
      esac
    fi
  done
}

# rpm passes the number of installs left, so 1+ is an upgrade whose new links
# are already in place (CHEF-3022); dpkg passes a word such as remove or purge.
case "$1" in
  [1-9]*) ;;
  *) cleanup_symlinks ;;
esac
